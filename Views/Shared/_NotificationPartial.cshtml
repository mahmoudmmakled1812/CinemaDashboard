@using CinemaDashboard.Constants

@{
    var success = TempData[NotificationConstants.SUCCESS_NOTIFICATION]?.ToString();
    var error = TempData[NotificationConstants.ERROR_NOTIFICATION]?.ToString();
    var warning = TempData[NotificationConstants.WARNING_NOTIFICATION]?.ToString();
    var information = TempData[NotificationConstants.INFORMATION_NOTIFICATION]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(warning))
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@warning
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(information))
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>@information
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
