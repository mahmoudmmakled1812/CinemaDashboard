@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string IsActive(string target) => string.Equals(controller, target, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html data-bs-theme="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Dashboard</title>
    <script src="~/falcon/public/assets/js/config.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/falcon/public/assets/css/theme.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/falcon/public/assets/css/user.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="main" id="top">
        <div class="container" data-layout="container">
            <nav class="navbar navbar-light navbar-vertical navbar-expand-xl">
                <div class="d-flex align-items-center">
                    <div class="toggle-icon-wrapper"><button class="btn navbar-toggler-humburger-icon navbar-vertical-toggle" type="button" aria-label="Toggle navigation"><span class="navbar-toggle-icon"><span class="toggle-line"></span></span></button></div>
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index"><div class="d-flex align-items-center py-3"><span class="d-flex flex-center rounded-circle bg-primary text-white me-2" style="width:40px;height:40px"><i class="fas fa-film"></i></span><span class="font-sans-serif text-primary fw-bold">Cinema</span></div></a>
                </div>
                <div class="collapse navbar-collapse" id="navbarVerticalCollapse">
                    <div class="navbar-vertical-content scrollbar"><ul class="navbar-nav flex-column mb-3" id="navbarVerticalNav">
                        <li class="nav-item"><a class="nav-link @IsActive("Home")" asp-controller="Home" asp-action="Index"><div class="d-flex align-items-center"><span class="nav-link-icon"><i class="fas fa-chart-pie"></i></span><span class="nav-link-text ps-1">Dashboard</span></div></a></li>
                        <li class="nav-item">
                            <div class="row navbar-vertical-label-wrapper mt-3 mb-2"><div class="col-auto navbar-vertical-label">Cinema Management</div><div class="col ps-0"><hr class="mb-0 navbar-vertical-divider" /></div></div>
                            <a class="nav-link @IsActive("Movies")" asp-controller="Movies" asp-action="Index"><div class="d-flex align-items-center"><span class="nav-link-icon"><i class="fas fa-video"></i></span><span class="nav-link-text ps-1">Movies</span></div></a>
                            <a class="nav-link @IsActive("Categories")" asp-controller="Categories" asp-action="Index"><div class="d-flex align-items-center"><span class="nav-link-icon"><i class="fas fa-tags"></i></span><span class="nav-link-text ps-1">Categories</span></div></a>
                            <a class="nav-link @IsActive("Cinemas")" asp-controller="Cinemas" asp-action="Index"><div class="d-flex align-items-center"><span class="nav-link-icon"><i class="fas fa-building"></i></span><span class="nav-link-text ps-1">Cinemas</span></div></a>
                            <a class="nav-link @IsActive("Actors")" asp-controller="Actors" asp-action="Index"><div class="d-flex align-items-center"><span class="nav-link-icon"><i class="fas fa-user-friends"></i></span><span class="nav-link-text ps-1">Actors</span></div></a>
                        </li>
                    </ul></div>
                </div>
            </nav>
            <div class="content">
                <nav class="navbar navbar-light navbar-glass navbar-top navbar-expand"><button class="btn navbar-toggler-humburger-icon navbar-toggler me-1 me-sm-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarVerticalCollapse" aria-controls="navbarVerticalCollapse" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggle-icon"><span class="toggle-line"></span></span></button><div class="d-flex align-items-center ms-auto"><span class="text-700 small">Cinema Management</span><span class="avatar avatar-xl ms-2"><span class="avatar-name rounded-circle bg-primary-subtle text-primary"><i class="fas fa-user"></i></span></span></div></nav>
                <div class="px-3 px-lg-4 pt-4">@RenderBody()</div>
                <footer class="footer"><div class="row g-0 justify-content-between fs-10 mt-4 mb-3 px-3 px-lg-4"><div class="col-auto"><p class="mb-0 text-600">Cinema Dashboard &copy; @DateTime.Now.Year</p></div></div></footer>
            </div>
        </div>
    </main>
    <script src="~/falcon/public/vendors/popper/popper.min.js" asp-append-version="true"></script>
    <script src="~/falcon/public/vendors/bootstrap/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/falcon/public/vendors/fontawesome/all.min.js" asp-append-version="true"></script>
    <script src="~/falcon/public/assets/js/theme.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
