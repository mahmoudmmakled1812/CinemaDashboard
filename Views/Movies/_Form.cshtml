@model CinemaDashboard.ViewModels.MovieFormViewModel
@using CinemaDashboard.Models
@{ var actors = ViewBag.Actors as List<Actor> ?? []; }
<form method="post" enctype="multipart/form-data" class="card shadow-sm border-0"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" /><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div><div class="col-md-3"><label asp-for="ShowDateTime" class="form-label"></label><input asp-for="ShowDateTime" type="datetime-local" class="form-control" /><span asp-validation-for="ShowDateTime" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CategoryId" class="form-label">Category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Choose category</option></select></div><div class="col-md-6"><label asp-for="CinemaId" class="form-label">Cinema</label><select asp-for="CinemaId" asp-items="ViewBag.Cinemas" class="form-select"><option value="">Choose cinema</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="col-md-6"><label asp-for="MainImage" class="form-label">Main image</label><input asp-for="MainImage" type="file" accept="image/*" class="form-control" />@if(Model.ExistingMainImageUrl is not null) { <img src="@Model.ExistingMainImageUrl" class="mt-2 rounded" style="width:90px;height:90px;object-fit:cover" /> }</div><div class="col-md-6"><label asp-for="SubImages" class="form-label">Sub images</label><input asp-for="SubImages" type="file" accept="image/*" multiple class="form-control" /><div class="d-flex gap-2 mt-2">@foreach(var image in Model.ExistingImages) { <div><img src="@image.Url" class="rounded" style="width:70px;height:70px;object-fit:cover" /><form asp-action="DeleteImage" asp-route-id="@image.Id" asp-route-movieId="@Model.Id"><button class="btn btn-sm btn-link text-danger p-0">Remove</button></form></div> }</div></div><div class="col-12"><label class="form-label">Actors</label><div class="row">@foreach(var actor in actors) { <div class="col-md-3 form-check ms-2"><input class="form-check-input" type="checkbox" name="ActorIds" value="@actor.Id" checked="@Model.ActorIds.Contains(actor.Id)" id="actor-@actor.Id" /><label class="form-check-label" for="actor-@actor.Id">@actor.Name</label></div> }</div></div><div class="col-12"><div class="form-check"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label">Available for booking</label></div></div></div></div><div class="card-footer bg-white d-flex gap-2"><button class="btn btn-primary">Save movie</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

