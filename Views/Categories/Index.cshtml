@model IEnumerable<CinemaDashboard.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="row g-4">
    
    <!-- Add Category Form -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h4>Add category</h4>
                
                <form asp-action="Create">
                    <!-- Name Field -->
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input 
                            name="Name" 
                            class="form-control" 
                            required 
                            maxlength="80" />
                    </div>

                    <button class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Categories List -->
    <div class="col-lg-8">
        <h1>Categories</h1>

        <!-- Error Message -->
        @if (TempData["Error"] is string e)
        {
            <div class="alert alert-warning">
                @e
            </div>
        }

        <!-- Categories Table -->
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th></th>
                </tr>
            </thead>
            
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        
                        <!-- Delete Action -->
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@item.Id">
                                <button 
                                    class="btn btn-sm btn-outline-danger" 
                                    onclick="return confirm('Delete this category?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>