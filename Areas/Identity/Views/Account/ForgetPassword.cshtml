@model CinemaDashboard.ViewModels.ForgetPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" style="width:64px;height:64px;">
                        <i class="fas fa-key fa-2x"></i>
                    </div>
                    <h2>Forgot password?</h2>
                    <p class="text-muted">Enter your email or username and we'll send you a verification code.</p>
                </div>

                <form asp-action="ForgetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="EmailOrUserName" class="form-label"></label>
                        <input asp-for="EmailOrUserName" class="form-control form-control-lg" autocomplete="username" autofocus />
                        <span asp-validation-for="EmailOrUserName" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="fas fa-paper-plane me-2"></i>Send verification code
                    </button>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="Login">Back to login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
