@model CinemaDashboard.ViewModels.ValidateOTPVM

@{
    ViewData["Title"] = "Verify Code";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-3" style="width:64px;height:64px;">
                    <i class="fas fa-shield-alt fa-2x"></i>
                </div>
                <h2>Verify your code</h2>
                <p class="text-muted">Enter the 6-digit code sent to your email. The code is valid for 10 minutes.</p>

                <form asp-action="ValidateOTP" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger text-start" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="OTP" class="form-label visually-hidden"></label>
                        <input asp-for="OTP" class="form-control form-control-lg text-center fw-bold" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" autofocus />
                        <span asp-validation-for="OTP" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Verify code</button>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="ForgetPassword">Request a new code</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
