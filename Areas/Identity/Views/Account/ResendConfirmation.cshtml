@model CinemaDashboard.ViewModels.ResendEmailConfirmationVM

@{
    ViewData["Title"] = "Resend Confirmation";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-lg-5">
                <div class="text-center mb-4">
                    <h2>Resend confirmation</h2>
                    <p class="text-muted">Enter your email or username to request a new confirmation link.</p>
                </div>

                <form asp-action="ResendConfirmation" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="EmailOrUserName" class="form-label"></label>
                        <input asp-for="EmailOrUserName" class="form-control form-control-lg" autocomplete="username" autofocus />
                        <span asp-validation-for="EmailOrUserName" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Send confirmation email</button>
                </form>

                <div class="text-center mt-4">
                    <a asp-action="Login">Back to login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
