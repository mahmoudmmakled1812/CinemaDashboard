@model CinemaDashboard.ViewModels.RegisterVM
@{ ViewData["Title"] = "Create account"; }
<div class="auth-shell register-shell row align-items-stretch g-0 shadow-lg"><aside class="col-lg-4 auth-aside d-none d-lg-flex"><div><span class="auth-logo"><i class="fas fa-ticket-alt"></i></span><p class="text-uppercase fw-bold small mt-4 mb-2">Join the experience</p><h1>Book movies your way.</h1><p class="mb-0 text-white-50">Create your account to save favorites, reserve seats and view your tickets anytime.</p></div><div class="auth-dots"><span></span><span></span><span></span></div></aside><section class="col-lg-8 bg-white"><div class="auth-form auth-form-wide mx-auto"><a asp-area="Customer" asp-controller="Home" asp-action="Index" class="auth-back"><i class="fas fa-arrow-left me-2"></i>Back to movies</a><div class="mt-4 mb-4"><span class="eyebrow">CREATE ACCOUNT</span><h2 class="mt-2 mb-1">Your movie journey starts here</h2><p class="text-muted">It only takes a minute to create your account.</p></div><form asp-action="Register" method="post" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control auth-control" autocomplete="given-name" placeholder="First name" /><span asp-validation-for="FirstName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control auth-control" autocomplete="family-name" placeholder="Last name" /><span asp-validation-for="LastName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control auth-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control auth-control" autocomplete="username" placeholder="Choose a username" /><span asp-validation-for="UserName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control auth-control" autocomplete="new-password" placeholder="At least 8 characters" /><span asp-validation-for="Password" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control auth-control" autocomplete="new-password" placeholder="Repeat password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div><div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control auth-control" autocomplete="street-address" placeholder="Your address" /><span asp-validation-for="Address" class="text-danger small"></span></div></div><button type="submit" class="btn btn-primary w-100 py-3 mt-4">Create my account <i class="fas fa-arrow-right ms-2"></i></button></form><p class="text-center text-muted mt-4 mb-0">Already have an account? <a asp-action="Login" class="fw-bold">Sign in</a></p></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
