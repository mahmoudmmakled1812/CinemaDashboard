@model CinemaDashboard.ViewModels.LoginVM
@{ ViewData["Title"] = "Welcome back"; }
<div class="auth-shell row align-items-stretch g-0 shadow-lg"><aside class="col-lg-5 auth-aside d-none d-lg-flex"><div><span class="auth-logo"><i class="fas fa-film"></i></span><p class="text-uppercase fw-bold small mt-4 mb-2">Cinema booking made simple</p><h1>Every great night starts with a great seat.</h1><p class="mb-0 text-white-50">Discover movies, choose your exact seat, and keep all your bookings in one place.</p></div><div class="auth-dots"><span></span><span></span><span></span></div></aside><section class="col-lg-7 bg-white"><div class="auth-form mx-auto"><a asp-area="Customer" asp-controller="Home" asp-action="Index" class="auth-back"><i class="fas fa-arrow-left me-2"></i>Back to movies</a><div class="mt-4 mb-4"><span class="eyebrow">WELCOME BACK</span><h2 class="mt-2 mb-1">Sign in to continue</h2><p class="text-muted">Manage bookings, favorites and your tickets.</p></div><form asp-action="Login" method="post" novalidate>@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div><div class="mb-3"><label asp-for="EmailOrUserName" class="form-label"></label><div class="input-group auth-input"><span class="input-group-text"><i class="far fa-user"></i></span><input asp-for="EmailOrUserName" class="form-control" autocomplete="username" autofocus placeholder="Email or username" /></div><span asp-validation-for="EmailOrUserName" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><div class="input-group auth-input"><span class="input-group-text"><i class="fas fa-lock"></i></span><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Your password" /></div><span asp-validation-for="Password" class="text-danger small"></span></div><div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check"><input asp-for="Remember" class="form-check-input" /><label asp-for="Remember" class="form-check-label">Remember me</label></div><a asp-action="ForgetPassword" class="small fw-semibold">Forgot password?</a></div><button type="submit" class="btn btn-primary w-100 py-3">Sign in <i class="fas fa-arrow-right ms-2"></i></button></form><p class="text-center text-muted mt-4 mb-0">New to Cinema? <a asp-action="Register" class="fw-bold">Create account</a></p></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
