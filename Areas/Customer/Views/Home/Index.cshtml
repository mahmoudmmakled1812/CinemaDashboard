@model CinemaDashboard.ViewModels.CustomerHomeVM
@{ ViewData["Title"] = "Cinema"; }
<section class="public-hero mb-5"><div class="row align-items-center g-4"><div class="col-lg-7"><span class="badge bg-warning text-dark mb-3">Your next movie night starts here</span><h1>Find your seat. Enjoy the show.</h1><p class="lead">Browse the latest movies, choose your cinema, and reserve your exact seat online.</p><a href="#movies" class="btn btn-primary btn-lg me-2">Explore movies</a>@if (!(User.Identity?.IsAuthenticated ?? false)){<a asp-area="Identity" asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">Create account</a>}</div><div class="col-lg-5"><div class="hero-stat"><strong>@Model.Movies.Count</strong><span>Movies available</span><strong>@Model.Cinemas.Count</strong><span>Cinema locations</span><strong>100</strong><span>Seats per show</span></div></div></div></section>
<section id="movies" class="mb-5"><div class="d-flex justify-content-between align-items-end mb-4"><div><h2>Now showing</h2><p class="text-muted mb-0">Pick a film and choose the seat you want.</p></div></div><div class="row g-4">@foreach (var movie in Model.Movies) {<div class="col-md-6 col-xl-4"><article class="card movie-public-card h-100 border-0 shadow-sm"><img src="@(movie.MainImageUrl ?? "/images/placeholder-movie.svg")" alt="@movie.Name"/><div class="card-body d-flex flex-column"><span class="small text-primary fw-bold">@movie.Category?.Name</span><h4 class="mt-1">@movie.Name</h4><p class="text-muted small">@movie.Description</p><p class="small mb-3"><i class="fas fa-map-marker-alt text-danger me-1"></i>@movie.Cinema?.Name<br/><i class="far fa-clock text-primary me-1"></i>@movie.ShowDateTime.ToString("dddd, dd MMM · h:mm tt")</p><div class="d-flex align-items-center justify-content-between mt-auto"><strong>@movie.Price.ToString("N0") EGP</strong><a asp-controller="Bookings" asp-action="SelectSeats" asp-route-movieId="@movie.Id" class="btn btn-primary">Choose seats</a></div></div></article></div>}</div></section>
<section class="mb-5"><div class="mb-4"><h2>Our cinemas</h2><p class="text-muted mb-0">Choose the location that suits you.</p></div><div class="row g-4">@foreach(var cinema in Model.Cinemas){<div class="col-md-4"><div class="card cinema-public-card border-0 shadow-sm"><img src="@(cinema.ImageUrl ?? "/images/placeholder-cinema.svg")" alt="@cinema.Name"/><div class="card-body"><h5 class="mb-0">@cinema.Name</h5></div></div></div>}</div></section>
<section class="mb-4"><div class="mb-4"><h2>Featured actors</h2><p class="text-muted mb-0">Faces you will see on the big screen.</p></div><div class="row g-4">@foreach(var actor in Model.Actors){<div class="col-6 col-md-3"><div class="card actor-public-card border-0 shadow-sm text-center"><img src="@(actor.ImageUrl ?? "/images/placeholder-actor.svg")" alt="@actor.Name"/><div class="card-body"><h6 class="mb-1">@actor.Name</h6><small class="text-muted">@actor.Bio</small></div></div></div>}</div></section>
