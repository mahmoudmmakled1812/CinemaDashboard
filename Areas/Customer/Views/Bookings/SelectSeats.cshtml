@model CinemaDashboard.ViewModels.SeatSelectionVM
@{ ViewData["Title"] = "Choose seats"; var movie = Model.Movie; }
<div class="booking-steps mb-4"><span class="active"><b>1</b> Select seats</span><i></i><span><b>2</b> Confirm payment</span><i></i><span><b>3</b> Your ticket</span></div><div class="row g-4 align-items-start"><div class="col-lg-8"><div class="card booking-card shadow-sm"><div class="card-body p-4 p-lg-5"><div class="d-flex gap-3 align-items-center mb-4"><img class="booking-poster" src="@(movie.MainImageUrl ?? "/images/placeholder-movie.svg")" alt="@movie.Name"/><div><span class="eyebrow">CHOOSE YOUR SEATS</span><h2 class="mb-1 mt-1">@movie.Name</h2><p class="mb-0 text-muted small"><i class="fas fa-map-marker-alt text-danger me-1"></i>@movie.Cinema?.Name · <i class="far fa-clock text-primary ms-1 me-1"></i>@movie.ShowDateTime.ToString("ddd, dd MMM · h:mm tt")</p></div></div><div class="screen"><span></span>SCREEN</div><form asp-action="Checkout" method="post" id="seat-form"><input type="hidden" name="movieId" value="@movie.Id" /><input type="hidden" id="selected-seats" name="selectedSeats" /><div class="seat-grid" style="--seats: @movie.SeatsPerRow">@for (var row = 1; row <= movie.SeatRows; row++) { @for (var seat = 1; seat <= movie.SeatsPerRow; seat++) { var key = $"{row}-{seat}"; var label = $"{(char)('A' + row - 1)}{seat}"; <button type="button" class="seat @(Model.ReservedSeats.Contains(key) ? "reserved" : "")" data-seat="@key" @(Model.ReservedSeats.Contains(key) ? "disabled" : null)>@label</button> } }</div><div class="seat-legend mt-4"><span><i class="legend available"></i>Available</span><span><i class="legend selected"></i>Selected</span><span><i class="legend reserved"></i>Reserved</span></div></form></div></div></div><aside class="col-lg-4"><div class="card booking-summary shadow-sm"><div class="card-body p-4"><span class="eyebrow">ORDER SUMMARY</span><h5 class="mt-2">Your seats</h5><div id="chosen-label" class="chosen-seats">Choose your seats from the map</div><div class="summary-row"><span>Ticket price</span><strong>@movie.Price.ToString("N0") EGP</strong></div><div class="summary-row total"><span>Total</span><strong id="total">0 EGP</strong></div><button form="seat-form" class="btn btn-primary w-100 py-3 mt-3" id="checkout" disabled>Pay & confirm <i class="fas fa-arrow-right ms-1"></i></button><p class="small text-muted text-center mt-3 mb-0"><i class="fas fa-lock me-1"></i>Secure demo payment</p></div></div></aside></div>
@section Scripts { <script>const picked=new Set(),out=document.getElementById('selected-seats'),chosen=document.getElementById('chosen-label'),total=document.getElementById('total'),submit=document.getElementById('checkout'),price=@movie.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);document.querySelectorAll('.seat:not(.reserved)').forEach(b=>b.addEventListener('click',()=>{b.classList.toggle('selected');b.classList.contains('selected')?picked.add(b.dataset.seat):picked.delete(b.dataset.seat);const labels=[...picked].map(v=>{const [r,s]=v.split('-');return String.fromCharCode(64+Number(r))+s;});out.value=[...picked].join(',');chosen.textContent=labels.length?labels.join(', '):'Choose your seats from the map';total.textContent=`${(price*labels.length).toLocaleString()} EGP`;submit.disabled=!labels.length;}));</script> }
