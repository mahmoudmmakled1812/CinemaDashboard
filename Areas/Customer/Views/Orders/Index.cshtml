@model IEnumerable<CinemaDashboard.Models.Order>
@{ ViewData["Title"] = "My orders"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h2 class="mb-0">My bookings</h2><a asp-controller="Home" class="btn btn-outline-primary">Browse movies</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Movie</th><th>Seats</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var order in Model) { <tr><td><strong>@order.Movie?.Name</strong><br/><small class="text-muted">@order.Movie?.ShowDateTime.ToString("f")</small></td><td>@string.Join(", ", order.Seats.OrderBy(x => x.RowNumber).ThenBy(x => x.SeatNumber).Select(x => x.Label))</td><td>@order.TotalAmount.ToString("C")<br/><small>@order.Payment?.Status</small></td><td><span class="badge @(order.Status == OrderStatus.Confirmed ? "bg-success" : "bg-secondary")">@order.Status</span></td><td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Details</a></td></tr> }</tbody></table></div></div>
@if(!Model.Any()){<div class="alert alert-info mt-3">You have not made any bookings yet.</div>}
