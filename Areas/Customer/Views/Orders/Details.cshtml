@model CinemaDashboard.Models.Order
@{ ViewData["Title"] = "Booking details"; var cancellable = Model.Status == OrderStatus.Confirmed && Model.Movie!.ShowDateTime.ToUniversalTime() - DateTime.UtcNow >= TimeSpan.FromHours(24); }
<div class="row justify-content-center"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-body p-4"><div class="d-flex justify-content-between"><div><h2>@Model.Movie?.Name</h2><p class="text-muted">@Model.Movie?.Cinema?.Name · @Model.Movie?.ShowDateTime.ToString("f")</p></div><span class="badge @(Model.Status == OrderStatus.Confirmed ? "bg-success" : "bg-secondary") align-self-start">@Model.Status</span></div><hr/><div class="row g-3"><div class="col-sm-6"><strong>Seats</strong><p>@string.Join(", ", Model.Seats.OrderBy(x => x.RowNumber).ThenBy(x => x.SeatNumber).Select(x => x.Label))</p></div><div class="col-sm-6"><strong>Payment</strong><p>@Model.TotalAmount.ToString("C") · @Model.Payment?.Status</p></div></div>@if(cancellable){<form asp-action="Cancel" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger" onclick="return confirm('Cancel this booking?')">Cancel booking</button></form>}else if(Model.Status == OrderStatus.Confirmed){<p class="text-muted small mb-0">Cancellation is unavailable within 24 hours of the show.</p>}<a asp-action="Index" class="btn btn-link mt-3 px-0">Back to bookings</a></div></div></div></div>
