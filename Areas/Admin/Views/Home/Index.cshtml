@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">Welcome to Cinema Dashboard administration.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary px-3 py-2">Administrator</span>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="fas fa-film fa-2x text-primary mb-3"></i>
                <h5>Movies</h5>
                <p class="text-muted">Manage movies, images and actors.</p>
                <a asp-area="" asp-controller="Movies" asp-action="Index" class="btn btn-outline-primary">Open movies</a>
            </div>
        </div>
    </div>
    @if (User.IsInRole(CinemaDashboard.Constants.RoleConstants.SUPER_ADMIN))
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="fas fa-users fa-2x text-primary mb-3"></i>
                    <h5>Users</h5>
                    <p class="text-muted">Manage application users and roles.</p>
                    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-primary">Open users</a>
                </div>
            </div>
        </div>
    }
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <i class="fas fa-tags fa-2x text-primary mb-3"></i>
                <h5>Categories</h5>
                <p class="text-muted">Manage cinema categories.</p>
                <a asp-area="" asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary">Open categories</a>
            </div>
        </div>
    </div>
</div>
