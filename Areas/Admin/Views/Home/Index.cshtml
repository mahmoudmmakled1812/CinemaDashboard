@model CinemaDashboard.ViewModels.AdminDashboardVM
@using CinemaDashboard.Constants

@{
    ViewData["Title"] = "Admin Dashboard";
    var isSuperAdmin = User.IsInRole(RoleConstants.SUPER_ADMIN);
}

<section class="admin-dashboard">
    <div class="admin-hero mb-4">
        <div>
            <span class="admin-eyebrow"><i class="fas fa-clapperboard me-2"></i>CINEMA CONTROL CENTER</span>
            <h1>Welcome back, @User.Identity?.Name</h1>
            <p>Track your cinema performance and manage content and bookings from one place.</p>
        </div>
        <div class="admin-hero-actions">
            <a class="btn btn-light" asp-area="" asp-controller="Movies" asp-action="Create"><i class="fas fa-plus me-2"></i>Add movie</a>
            <a class="btn btn-hero-outline" asp-area="" asp-controller="Movies" asp-action="Index"><i class="fas fa-film me-2"></i>All movies</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3"><a class="stat-card stat-card-primary" asp-area="" asp-controller="Movies" asp-action="Index"><span class="stat-icon"><i class="fas fa-film"></i></span><span><small>Total movies</small><strong>@Model.Movies</strong><em>Manage movies and showtimes <i class="fas fa-arrow-right"></i></em></span></a></div>
        <div class="col-12 col-sm-6 col-xl-3"><a class="stat-card stat-card-violet" asp-area="" asp-controller="Cinemas" asp-action="Index"><span class="stat-icon"><i class="fas fa-building"></i></span><span><small>Cinema locations</small><strong>@Model.Cinemas</strong><em>Add and update cinemas <i class="fas fa-arrow-right"></i></em></span></a></div>
        <div class="col-12 col-sm-6 col-xl-3"><a class="stat-card stat-card-amber" asp-area="Admin" asp-controller="Orders" asp-action="Index"><span class="stat-icon"><i class="fas fa-ticket-alt"></i></span><span><small>Confirmed bookings</small><strong>@Model.ConfirmedOrders</strong><em>View all bookings <i class="fas fa-arrow-right"></i></em></span></a></div>
        <div class="col-12 col-sm-6 col-xl-3"><div class="stat-card stat-card-success"><span class="stat-icon"><i class="fas fa-wallet"></i></span><span><small>Total revenue</small><strong>@Model.Revenue.ToString("N0") <small>EGP</small></strong><em>From confirmed bookings</em></span></div></div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="dashboard-panel h-100">
                <div class="panel-heading"><div><span class="panel-kicker">LATEST ACTIVITY</span><h2>Recent bookings</h2></div><a asp-area="Admin" asp-controller="Orders" asp-action="Index">View all <i class="fas fa-arrow-right ms-1"></i></a></div>
                @if (Model.RecentOrders.Any())
                {
                    <div class="table-responsive"><table class="table dashboard-orders align-middle mb-0"><thead><tr><th>Booking</th><th>Movie</th><th>Customer</th><th>Amount</th><th>Status</th></tr></thead><tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr><td><strong>#@order.Id</strong><small>@order.CreatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</small></td><td>@(order.Movie?.Name ?? "—")</td><td>@(order.ApplicationUser?.UserName ?? "—")</td><td>@order.TotalAmount.ToString("N2") EGP</td><td><span class="status-pill @(order.Status == CinemaDashboard.Models.OrderStatus.Confirmed ? "status-confirmed" : "status-cancelled")">@order.Status</span></td></tr>
                    }
                    </tbody></table></div>
                }
                else
                {
                    <div class="dashboard-empty"><i class="far fa-calendar-check"></i><p>No bookings yet.</p></div>
                }
            </div>
        </div>
        <div class="col-xl-4">
            <div class="dashboard-panel quick-actions h-100">
                <div class="panel-heading"><div><span class="panel-kicker">QUICK ACTIONS</span><h2>Quick add</h2></div></div>
                <a class="quick-action" asp-area="" asp-controller="Movies" asp-action="Create"><span class="quick-icon quick-icon-primary"><i class="fas fa-film"></i></span><span><strong>Add movie</strong><small>Create a new movie and showtime</small></span><i class="fas fa-chevron-right"></i></a>
                <a class="quick-action" asp-area="" asp-controller="Cinemas" asp-action="Index"><span class="quick-icon quick-icon-violet"><i class="fas fa-building"></i></span><span><strong>Add cinema</strong><small>Create a cinema location</small></span><i class="fas fa-chevron-right"></i></a>
                <a class="quick-action" asp-area="" asp-controller="Categories" asp-action="Index"><span class="quick-icon quick-icon-amber"><i class="fas fa-tags"></i></span><span><strong>Add category</strong><small>Organize your movie catalogue</small></span><i class="fas fa-chevron-right"></i></a>
                <a class="quick-action" asp-area="" asp-controller="Actors" asp-action="Index"><span class="quick-icon quick-icon-success"><i class="fas fa-user-plus"></i></span><span><strong>Add actor</strong><small>Add to the cast directory</small></span><i class="fas fa-chevron-right"></i></a>
                @if (isSuperAdmin)
                {
                    <a class="quick-action" asp-area="Admin" asp-controller="User" asp-action="Index"><span class="quick-icon quick-icon-dark"><i class="fas fa-users-cog"></i></span><span><strong>Users</strong><small>@Model.Customers registered accounts</small></span><i class="fas fa-chevron-right"></i></a>
                }
            </div>
        </div>
    </div>
</section>
