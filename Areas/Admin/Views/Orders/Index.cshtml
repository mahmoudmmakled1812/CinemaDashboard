@model IEnumerable<CinemaDashboard.Models.Order>
@{ ViewData["Title"] = "Manage orders"; }
<div class="mb-4"><h1 class="mb-1">Manage orders</h1><p class="text-muted mb-0">All customer reservations and payment status.</p></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Movie</th><th>Seats</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach(var order in Model){<tr><td>#@order.Id<br/><small>@order.CreatedAtUtc.ToLocalTime().ToString("g")</small></td><td>@order.ApplicationUser?.Email</td><td>@order.Movie?.Name</td><td>@string.Join(", ", order.Seats.OrderBy(x=>x.RowNumber).ThenBy(x=>x.SeatNumber).Select(x=>x.Label))</td><td>@order.TotalAmount.ToString("C")<br/><small>@order.Payment?.Status</small></td><td><span class="badge @(order.Status == CinemaDashboard.Models.OrderStatus.Confirmed ? "bg-success" : "bg-secondary")">@order.Status</span></td></tr>}</tbody></table></div></div>
